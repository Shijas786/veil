# Firebase web app config (Project settings → Your apps → SDK setup). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA v3 site key, or set VITE_APPCHECK_PROVIDER=enterprise)
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_PROVIDER=
